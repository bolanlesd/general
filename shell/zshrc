# =====================
# general — modular zshrc loader
# =====================
# Sources every shell/parts/*.zsh in lexical order. To add new shell
# customisation, drop a new file into shell/parts/ (NN-name.zsh).
# After editing, run `scripts/build-zshrc.sh` to refresh dist/zshrc
# (used by the offline / remote fallback bootstrap).

GENERAL_PARTS_DIR="${GENERAL_PARTS_DIR:-$HOME/git/general/shell/parts}"

if [ -d "$GENERAL_PARTS_DIR" ]; then
  for _part in "$GENERAL_PARTS_DIR"/*.zsh; do
    [ -r "$_part" ] && source "$_part"
  done
  unset _part
fi

# Per-machine overrides (not version-controlled)
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

echo "✅ Loaded custom zshrc (modular)"
