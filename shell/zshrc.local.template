# --- 1. Environment ---
export VISUAL=vim
export EDITOR="$VISUAL"

# --- 1.5 Keyboard Behavior Fix ---
bindkey -e  # Use Emacs mode for normal typing and Option + Arrow navigation

# --- 2. Load main zshrc (prefer local clone, fall back to GitHub) ---
LOCAL_ZSHRC=~/git/general/shell/zshrc
REMOTE_ZSHRC=~/local_copy_zshrc
REMOTE_URL="https://raw.githubusercontent.com/bolanlesd/general/my-mac/shell/zshrc"

if [[ -f "$LOCAL_ZSHRC" ]]; then
  source "$LOCAL_ZSHRC"
else
  echo "ℹ️  $LOCAL_ZSHRC not found, falling back to GitHub..."
  curl --silent --fail --output "$REMOTE_ZSHRC" "$REMOTE_URL" \
    && echo "✅ Downloaded latest zshrc from GitHub" \
    || echo "❌ Failed to download remote zshrc!"
  [[ -f "$REMOTE_ZSHRC" ]] && source "$REMOTE_ZSHRC"
fi

# --- 3. Git branch prompt using vcs_info ---
autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats '(%b)'
add-zsh-hook precmd vcs_info

setopt prompt_subst
PROMPT='%F{yellow}%* %F{blue}%~ %F{green}${vcs_info_msg_0_}%f $ '

# --- 4. Homebrew path ---
eval "$(/opt/homebrew/bin/brew shellenv)"

# --- 5. Completions (only once) ---
autoload -Uz compinit
compinit

echo "✅ Loaded custom .zshrc"